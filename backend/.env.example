# Copy this file to ".env" for local development and fill in the values.
# On Render (or any host), set the same names in the host's "Environment" page instead.
# NEVER commit your real .env file. It is ignored by git.
# Step-by-step instructions: docs/DEPLOYMENT.md

# ---------- Supabase (required) ----------
# Supabase dashboard -> Connect -> "Session pooler" connection string, with your database password.
# (The "Direct connection" needs IPv6, which most hosts do not have.)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase -> Project Settings -> API Keys -> "secret" key (sb_secret_...), or the legacy "service_role" key.
# Server only: it can read every file in Storage. Never put it in the frontend.
SUPABASE_SECRET_KEY=
# Only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys -> "Legacy JWT secret").
# New projects sign logins with signing keys and do not need this.
SUPABASE_JWT_SECRET=
# Name of the private Storage bucket made by supabase/migrations/0005_storage_bucket.sql
STORAGE_BUCKET=project-assets
# Any long random text. Create one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_TOKEN_SECRET=

# The website address(es) allowed to call this API, comma separated.
# Local: http://localhost:3000   Deployed: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Which provider each AI service uses ----------
#   LANGUAGE_PROVIDER: auto | anthropic | mock
#   IMAGE_PROVIDER:    auto | gemini | openai | mock
#   TUTORIAL_PROVIDER: auto | youtube | mock   (mock = no video search, links only)
# "auto" uses a real provider only when its key below is filled in, otherwise the free mock.
LANGUAGE_PROVIDER=auto
IMAGE_PROVIDER=auto
TUTORIAL_PROVIDER=auto

# Fake delay (milliseconds) added by mock providers so you can see loading states. Use 0 on a server.
MOCK_LATENCY_MS=500

# Limits per signed-in user, per minute.
GENERATION_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Max upload size in megabytes.
MAX_UPLOAD_MB=5

# How often posts and accounts past their 30-day grace period are removed for good (hours; 0 = never).
PURGE_INTERVAL_HOURS=6

# ---------- Real AI (costs money; see README "Turn on real AI") ----------
# Paste keys ONLY into .env or the host's environment settings (never into code, never share them).
# Leave a key empty to keep that service free (mock).

# Anthropic API, for design planning, fabric advice, materials and design ideas.
# Get a key at https://console.anthropic.com (needs its own billing; a chat app subscription does not cover it).
ANTHROPIC_API_KEY=
# The model name, copied from the Models page in the Anthropic console (the newest Opus model is a good choice).
# Real AI needs both the key and the model name; if either is empty the free mock is used.
ANTHROPIC_MODEL=
# How hard the model thinks: low | medium | high. Higher = better but slower and pricier.
ANTHROPIC_EFFORT=medium

# Google Gemini image generation ("Nano Banana"), for sketches and previews.
# Get a key at https://aistudio.google.com (billing must be turned on for image models).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# OpenAI GPT Image, an alternative image provider. Used only if no Gemini key is set
# (or if IMAGE_PROVIDER=openai). Get a key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high (higher looks better and costs more)
OPENAI_IMAGE_QUALITY=medium

# Safety limit in US dollars per day, for ALL users together. Paid AI stops for the day
# once the estimated spend reaches this. $1 is about Rs 88.
DAILY_BUDGET_USD=1.0

# ---------- Tutorial search (free, no billing) ----------
# YouTube Data API v3, for Generate Tutorial and the Learning Library.
# Free within a daily quota of 10,000 units: one search = 100 units (about 100 searches a day).
# Create a key: https://console.cloud.google.com -> new project -> "APIs & Services" ->
# enable "YouTube Data API v3" -> Credentials -> Create credentials -> API key.
YOUTUBE_API_KEY=
