{
  "name": "ai-fashion-notebook-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:cleanup": "node e2e/support/cleanup.mjs",
    "test:stitching-browser": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "esbuild": "0.28.2",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3"
  }
}
