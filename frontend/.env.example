# Copy this file to ".env.local" for local development.
# On Vercel, set the same names in Project -> Settings -> Environment Variables.
#
# Only NEXT_PUBLIC_ values reach the browser, so NEVER put secret keys here
# (no SUPABASE_SECRET_KEY / service_role key, no AI keys). They belong to the backend only.

# Where the FastAPI backend runs. Local: http://localhost:8000
# Deployed: your Render address, e.g. https://croquis-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase -> Project Settings -> API Keys -> "publishable" key (sb_publishable_...),
# or the legacy "anon" key. This one is safe in the browser: it is only used for signing in.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: an email address shown on the Help page for support. Leave empty to show only "Report a problem".
NEXT_PUBLIC_SUPPORT_EMAIL=
